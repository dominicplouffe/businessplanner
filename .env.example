# Anthropic — optional. Without it the app falls back to recorded fixtures.
ANTHROPIC_API_KEY=

# Database — SQLite for local dev, Postgres in production.
DATABASE_URL="file:./prisma/dev.db"

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — falls back to a console transport when unset.
RESEND_API_KEY=
