# Venturelly production settings. `scripts/lightsail.sh init` copies this to
# deploy/.env.production (git-ignored) and fills in the generated secrets.
# Keep that file in a password manager: BETTER_AUTH_SECRET signs every
# session, and the database password is only written down here.
#
# The app refuses to start in production without everything above the
# "optional" line — see assertProductionEnv() in src/lib/env.ts.

NEXT_PUBLIC_SITE_URL=https://getventurely.com
BETTER_AUTH_URL=https://getventurely.com

# --- generated by init ---------------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=
BETTER_AUTH_SECRET=

# --- payments (live mode) ---------------------------------------------------
# The webhook endpoint can be created in Stripe before the server exists:
#   https://getventurely.com/api/stripe/webhook
# Its signing secret goes here. The webhook is the only code that grants an
# entitlement, so a deploy without it takes money and unlocks nothing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids, not secrets. Check they still charge what the site says with
# `node scripts/stripe-verify.mjs`.
STRIPE_PRICE_UNLOCK=price_1UI4trCh541LMojtKfufpOno
STRIPE_PRICE_LIVE=price_1UI4tsCh541LMojtsr3JcQN4

# Where Let's Encrypt sends certificate expiry notices. Required: Caddy
# refuses its whole configuration when this is empty, and serves nothing.
ACME_EMAIL=

# --- optional ---------------------------------------------------------------
# Without it the fixture generator writes the prose; init copies it from
# .env.local when present.
ANTHROPIC_API_KEY=

