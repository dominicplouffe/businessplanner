# Anthropic — optional. Without it the app falls back to recorded fixtures.
ANTHROPIC_API_KEY=

# Database. The driver adapter is chosen from the URL, so this one value
# decides SQLite or Postgres — there is no second flag to get out of step.
# Production must be Postgres; the app refuses to start otherwise, because
# SQLite on a container filesystem is discarded on every deploy.
DATABASE_URL="file:./prisma/dev.db"

# The public origin. Every canonical URL, sitemap entry, OpenGraph tag and
# Stripe redirect derives from it, so a staging deployment that leaves this at
# the production value advertises the wrong host everywhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode). With both unset, checkout is simulated locally at
# /billing/simulate — the simulated payment posts to the same webhook handler a
# real one does, so the code that grants an entitlement is exercised rather than
# bypassed. That path refuses to run when NODE_ENV=production.
#
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout charges against a Stripe price id, not an amount, so the catalogue
# is reportable. These are mode-specific: test ids do not exist in live.
# `node scripts/stripe-verify.mjs` checks they still match pricing in brand.ts.
STRIPE_PRICE_UNLOCK=
STRIPE_PRICE_LIVE=

# Email — falls back to a console transport when unset.
RESEND_API_KEY=

# PDF export. Playwright normally finds its own Chromium; set this when the
# installed browser does not match the Playwright version — a container image
# with a system Chromium, or a serverless build using @sparticuz/chromium.
CHROMIUM_EXECUTABLE_PATH=
