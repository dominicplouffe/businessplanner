# Anthropic — optional. Without it the app falls back to recorded fixtures.
ANTHROPIC_API_KEY=

# Database — SQLite for local dev, Postgres in production.
DATABASE_URL="file:./prisma/dev.db"

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode). With both unset, checkout is simulated locally at
# /billing/simulate — the simulated payment posts to the same webhook handler a
# real one does, so the code that grants an entitlement is exercised rather than
# bypassed. That path refuses to run when NODE_ENV=production.
#
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — falls back to a console transport when unset.
RESEND_API_KEY=

# PDF export. Playwright normally finds its own Chromium; set this when the
# installed browser does not match the Playwright version — a container image
# with a system Chromium, or a serverless build using @sparticuz/chromium.
CHROMIUM_EXECUTABLE_PATH=
